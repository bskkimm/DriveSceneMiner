# Copy to .env locally or export this variable. Never commit real credentials.
TYPESAFE_API_KEY=your_jev_api_key_here

# Optional OpenAI Decisions provider.
OPENAI_API_KEY=your_openai_api_key_here

# Optional Microsoft Foundry provider. Replace these with an existing deployment.
MICROSOFT_DECISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
MICROSOFT_DECISION_DEPLOYMENT=your_deployment_name
MICROSOFT_DECISION_API_KEY=your_microsoft_api_key_here
# Alternatively, supply a current Entra token instead of an API key.
# MICROSOFT_DECISION_ENTRA_TOKEN=your_current_token_here
